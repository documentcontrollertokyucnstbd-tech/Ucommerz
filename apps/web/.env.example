# ---- Client-exposed (must be prefixed NEXT_PUBLIC_) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Server-only ----
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
EMAIL_FROM=notifications@ucommerz.com
# Random string (openssl rand -hex 32). Also the Bearer token for /api/reminders/* and /api/cron/*
SESSION_SECRET=

# ---- Optional security tuning ----
ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW=60000
ADMIN_IP_BLACKLIST=
# Set to "true" to restrict /admin to ADMIN_IP_WHITELIST
ENFORCE_ADMIN_IP_WHITELIST=false
ADMIN_IP_WHITELIST=
